# Copy to .env and fill in. Every setting is optional unless marked REQUIRED.

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string          # REQUIRED in production
DEBUG=false
ALLOWED_HOSTS=reminders.example.org
CSRF_TRUSTED_ORIGINS=https://reminders.example.org
DATABASE_URL=postgres://docketbell:docketbell@db:5432/docketbell
TIME_ZONE=America/New_York
BEHIND_HTTPS_PROXY=true

# --- Your organization (shown in texts) -----------------------------------
DOCKETBELL_ORG_NAME=Main Street Defenders
DOCKETBELL_ORG_PHONE=(212) 555-0199
DOCKETBELL_PUBLIC_URL=https://reminders.example.org

# --- Reminder schedule ----------------------------------------------------
DOCKETBELL_REMINDER_DAYS=7,3,1
DOCKETBELL_SEND_TIME=10:00
DOCKETBELL_SEND_WINDOW=08:00-20:00
DOCKETBELL_SEND_MISSED_FOLLOW_UP=true
DOCKETBELL_RETENTION_DAYS=0

# --- SMS: console | twilio | http | dotted.path.to.YourBackend ------------
SMS_BACKEND=console

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Generic HTTP gateway (see docs/sms-gateways.md)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_INBOUND_TOKEN=
